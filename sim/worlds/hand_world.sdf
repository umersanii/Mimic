<?xml version="1.0" ?>
<sdf version="1.9">

  <!-- Standalone Gazebo world for the dual InMoov-derived hand models (left + right),
       sourced from MyRobotLab/inmoov_ros meshes - see CLAUDE.md for full provenance.
       Both hands are fixed in space via a world-mount joint (not free-falling) so
       finger/wrist joints can be exercised directly through JointPositionController
       topics without also needing an arm/gravity-compensation setup.

       Physics engine is bullet-featherstone, NOT dartsim (the default used
       by box_world.sdf): dartsim in this Gazebo build silently ignores
       <mimic> joints ("physics engine does not support mimic constraints"),
       which breaks the 1-driven-joint-per-finger coupling this model
       depends on. Verified: bullet-featherstone applies mimic correctly - but
       ONLY when the driver joint is proximal (closer to hand_link) and every
       mimic joint is downstream of it. See generate_hand.py for the same note. -->
  <world name="hand_world">

    <physics name="1ms" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- Two hands ~0.4m apart, each ~10-30cm across; gz-sim's default camera pose
         frames a room-sized scene, so without this both hands are barely-visible
         specks on load. -->
    <gui>
      <camera name="user_camera">
        <pose>0.5 0.5 1.3 0 0.3 -2.35</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <!-- Key light. Shadows off: verified on the old single-hand model that the "jitter"
           isn't physics (sampled every joint at ~1kHz with zero commands sent, all flat to
           ~1e-8 rad) - default shadow-map settings are tuned for room-scale scenes and
           produce shadow acne/flicker on this hand's many close-set small meshes,
           which visually reads as jitter. Same root cause applies to this mesh set.
           Any additional light added to this world must also keep cast_shadows false
           for the same reason. -->
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.9 0.88 0.85 1</diffuse>
    </light>

    <!-- Fill lights: two dim point lights front-left/front-right of the bench, workshop
         "softbox" placement so the hand meshes don't read as flat/silhouetted from the
         single overhead sun. Kept low intensity so the sun remains the dominant/key light. -->
    <light type="point" name="fill_light_left">
      <cast_shadows>false</cast_shadows>
      <pose>-0.6 0.6 1.1 0 0 0</pose>
      <diffuse>0.5 0.48 0.45 1</diffuse>
      <attenuation>
        <range>5</range>
        <constant>0.4</constant>
        <linear>0.3</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
    </light>
    <light type="point" name="fill_light_right">
      <cast_shadows>false</cast_shadows>
      <pose>0.6 0.6 1.1 0 0 0</pose>
      <diffuse>0.5 0.48 0.45 1</diffuse>
      <attenuation>
        <range>5</range>
        <constant>0.4</constant>
        <linear>0.3</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <!-- Darker workshop-floor grey, dimmed from the original flat 0.8/0.8 and further
                 matched down to the backdrop_wall's tone so the bench + backdrop read as the
                 focal staging instead of a bright void around them. -->
            <ambient>0.16 0.16 0.17 1</ambient>
            <diffuse>0.19 0.19 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Workbench: static box top + 4 legs. Top surface is at z=0.45 - both hand models'
         world_mount point sits exactly here (base_link's origin is the forearm's cut/elbow
         end - see the per-hand <pose> comments below), so each hand visually stands up
         from the table rather than floating above it. Purely a visual/staging prop: no
         collision is enforced between the table and the hand meshes during finger curl. -->
    <model name="workbench">
      <!-- Single link with 5 collision/visual elements (top + 4 legs), not 5 separate
           links - bullet-featherstone (see world-level comment on physics engine choice)
           rejects models with multiple unconnected links/sub-trees and no joints tying
           them together, even when the model is static. -->
      <static>true</static>
      <link name="workbench_link">
        <collision name="top_collision">
          <pose>0 0 0.435 0 0 0</pose>
          <geometry><box><size>1.0 0.55 0.03</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.435 0 0 0</pose>
          <geometry><box><size>1.0 0.55 0.03</size></box></geometry>
          <material>
            <ambient>0.22 0.18 0.15 1</ambient>
            <diffuse>0.28 0.22 0.18 1</diffuse>
          </material>
        </visual>
        <collision name="leg_fl_collision">
          <pose>-0.45 -0.22 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.42</length></cylinder></geometry>
        </collision>
        <visual name="leg_fl_visual">
          <pose>-0.45 -0.22 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <collision name="leg_fr_collision">
          <pose>0.45 -0.22 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.42</length></cylinder></geometry>
        </collision>
        <visual name="leg_fr_visual">
          <pose>0.45 -0.22 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <collision name="leg_bl_collision">
          <pose>-0.45 0.22 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.42</length></cylinder></geometry>
        </collision>
        <visual name="leg_bl_visual">
          <pose>-0.45 0.22 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <collision name="leg_br_collision">
          <pose>0.45 0.22 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.42</length></cylinder></geometry>
        </collision>
        <visual name="leg_br_visual">
          <pose>0.45 0.22 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Backdrop wall behind the bench (photo-booth style: floor + bench + wall), charcoal
         workshop tone so screenshots/video don't trail off into the bare ground plane.
         Placed at -y: the existing overview <gui><camera> sits at (0.5, 0.5, 1.3) looking
         toward the origin (yaw -2.35 rad), so the open/front side is +x/+y and "behind"
         the hands from that view is -y - a wall on the +y side would sit between the
         camera and the hands and block the shot. -->
    <model name="backdrop_wall">
      <static>true</static>
      <link name="link">
        <pose>0 -0.45 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.6 0.05 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.05 1.5</size></box></geometry>
          <material>
            <ambient>0.16 0.16 0.17 1</ambient>
            <diffuse>0.19 0.19 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='inmoov_left_hand'>
    <!-- Visually re-verified in the GUI: with roll=pi the forearm/hand assembly extends
         UPWARD from base_link's origin (fingers up), not down as the old single-hand
         model's comment assumed - base_link's origin is effectively the cut/elbow end.
         Mount z is set to the workbench top surface (0.45) so that elbow end sits on
         the table and the hand stands up from it, instead of floating at the old z=1. -->
    <pose>-0.2 0 0.45 3.14159 0 1.5708</pose>
    <link name='base_link'>
      <inertial>
        <pose>0.0002699999999999999 -0.0013140000000000001 -0.13950299999999999 0 0 0</pose>
        <mass>0.089999999999999997</mass>
        <inertia>
          <ixx>0.00082543799999999974</ixx>
          <ixy>6.6174449004242207e-24</ixy>
          <ixz>8.4703294725430034e-22</ixz>
          <iyy>0.0008331250000000001</iyy>
          <iyz>0</iyz>
          <izz>0.00016974700000000001</izz>
        </inertia>
      </inertial>
      <collision name='base_link_fixed_joint_lump__forearm_link_collision_collision'>
        <pose>0.00027 -0.0013140000000000001 -0.13950299999999999 0 0 0</pose>
        <geometry>
          <box>
            <size>0.108761 0.10394200000000001 0.31504700000000002</size>
          </box>
        </geometry>
      </collision>
      <visual name='base_link_fixed_joint_lump__forearm_link_visual_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>../models/hand/left/meshes/l_forearm.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.32 0.32 0.30 1</ambient>
          <diffuse>0.80 0.80 0.76 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>
    <joint name='wrist_joint' type='revolute'>
      <pose relative_to='base_link'>-0.0144 -0.01 -0.28849999999999998 0 0 0</pose>
      <parent>base_link</parent>
      <child>hand_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>3.1415899999999999</upper>
          <effort>2</effort>
          <velocity>1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='hand_link'>
      <pose relative_to='wrist_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.00061799999999999995 0.0040000000000000001 -0.064310000000000006 0 0 0</pose>
        <mass>0.080000000000000002</mass>
        <inertia>
          <ixx>0.000167935</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000123199</iyy>
          <iyz>0</iyz>
          <izz>7.0939999999999995e-05</izz>
        </inertia>
      </inertial>
      <collision name='hand_link_collision_collision'>
        <pose>0.00061799999999999995 0.0040000000000000001 -0.064310000000000006 0 0 0</pose>
        <geometry>
          <box>
            <size>0.044331000000000002 0.093143000000000004 0.12850900000000001</size>
          </box>
        </geometry>
      </collision>
      <visual name='hand_link_visual_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>../models/hand/left/meshes/l_hand.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.32 0.32 0.30 1</ambient>
          <diffuse>0.80 0.80 0.76 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>
    <joint name='index1_joint' type='revolute'>
      <pose relative_to='hand_link'>-0.0015 -0.034200000000000001 -0.11899999999999999 -0.099999999999999978 0 0</pose>
      <parent>hand_link</parent>
      <child>index1_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.5708</upper>
          <effort>2</effort>
          <velocity>0.78539999999999999</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='index1_link'>
      <pose relative_to='index1_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.000214 -3.4999999999999997e-05 -0.018217000000000001 0 0 0</pose>
        <mass>0.012</mass>
        <inertia>
          <ixx>2.6809999999999998e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.6769999999999999e-06</iyy>
          <iyz>0</iyz>
          <izz>5.9800000000000003e-07</izz>
        </inertia>
      </inertial>
      <collision name='index1_link_collision_collision'>
        <pose>0.000214 -3.4999999999999997e-05 -0.018217000000000001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.017239000000000001 0.017350000000000001 0.048786000000000003</size>
          </box>
        </geometry>
      </collision>
      <visual name='index1_link_visual_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>../models/hand/left/meshes/index3_1.stl</uri>
          </mesh>
        </geometry>
        <cast_shadows>false</cast_shadows>
        <material>
          <ambient>0.32 0.32 0.30 1</ambient>
          <diffuse>0.80 0.80 0.76 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>
    <joint name='index_joint' type='revolute'>
      <pose relative_to='index1_link'>0 0.001 -0.035950000000000003 0 0 0</pose>
      <parent>index1_link</parent>
      <child>index2_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <mimic joint='index1_joint'>
          <multiplier>1</multiplier>
          <offset>0</offset>
          <reference>0</reference>
        </mimic>
        <limit>
          <lower>0</lower>
          <upper>1.5708</upper>
          <effort>0</effort>
          <velocity>0.78539999999999999</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='index2_link'>
      <pose relative_to='index_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.00094600000000000001 3.4999999999999997e-05 -0.012097999999999999 0 0 0</pose>
        <mass>0.0080000000000000002</mass>
        <inertia>
          <ixx>9.3099999999999996e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.5300000000000002e-07</iyy>
          <iyz>0</iyz>
          <izz>3.3700000000000001e-07</izz>
        </inertia>
      </inertial>
      <collision name='index2_link_collision_collision'>
