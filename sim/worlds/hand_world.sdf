        </geometry>
      </collision>
      <visual name='middle2_link_visual_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>../models/hand/left/meshes/middle3_2.stl</uri>
          </mesh>
        </geometry>
        <cast_shadows>false</cast_shadows>
        <material>
          <ambient>0.32 0.32 0.30 1</ambient>
          <diffuse>0.80 0.80 0.76 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
