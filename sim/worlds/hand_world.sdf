      <inertial>
        <pose>0.00013200000000000001 5.0000000000000004e-06 -0.019390999999999999 0 0 0</pose>
        <mass>0.012</mass>
        <inertia>
          <ixx>3.0819999999999999e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.078e-06</iyy>
          <iyz>0</iyz>
