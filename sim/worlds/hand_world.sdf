        <geometry>
          <box>
            <size>0.016419 0.01536 0.034057999999999998</size>
          </box>
        </geometry>
      </collision>
      <visual name='index2_link_visual_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>../models/hand/left/meshes/index3_2.stl</uri>
          </mesh>
        </geometry>
        <cast_shadows>false</cast_shadows>
        <material>
          <ambient>0.32 0.32 0.30 1</ambient>
          <diffuse>0.80 0.80 0.76 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>
    <joint name='index3_joint' type='revolute'>
      <pose relative_to='index2_link'>0 0 -0.024 0 0 0</pose>
      <parent>index2_link</parent>
      <child>index3_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <mimic joint='index1_joint'>
          <multiplier>1</multiplier>
          <offset>0</offset>
          <reference>0</reference>
        </mimic>
        <limit>
          <lower>0</lower>
          <upper>1.5708</upper>
          <effort>0</effort>
          <velocity>0.78539999999999999</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='index3_link'>
      <pose relative_to='index3_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.00018100000000000001 -3.8999999999999999e-05 -0.012760000000000001 0 0 0</pose>
        <mass>0.0050000000000000001</mass>
        <inertia>
          <ixx>6.0100000000000005e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.13e-07</iyy>
          <iyz>0</iyz>
          <izz>1.9000000000000001e-07</izz>
        </inertia>
      </inertial>
      <collision name='index3_link_collision_collision'>
