        <cast_shadows>false</cast_shadows>
        <material>
          <ambient>0.32 0.32 0.30 1</ambient>
          <diffuse>0.80 0.80 0.76 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>
    <joint name='middle1_joint' type='revolute'>
      <pose relative_to='hand_link'>-0.00175 -0.0070000000000000001 -0.12325 0 0 0</pose>
      <parent>hand_link</parent>
      <child>middle1_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.5708</upper>
          <effort>2</effort>
          <velocity>0.78539999999999999</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
