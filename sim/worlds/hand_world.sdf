            <scale>0.001 0.001 0.001</scale>
            <uri>../models/hand/left/meshes/middle3_1.stl</uri>
          </mesh>
        </geometry>
        <cast_shadows>false</cast_shadows>
        <material>
          <ambient>0.32 0.32 0.30 1</ambient>
          <diffuse>0.80 0.80 0.76 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>
    <joint name='middle_joint' type='revolute'>
      <pose relative_to='middle1_link'>0 0 -0.038899999999999997 0 0 0</pose>
      <parent>middle1_link</parent>
      <child>middle2_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <mimic joint='middle1_joint'>
          <multiplier>1</multiplier>
