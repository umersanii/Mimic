    <link name='middle2_link'>
      <pose relative_to='middle_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.0010300000000000001 -1.7e-05 -0.012930000000000001 0 0 0</pose>
        <mass>0.0080000000000000002</mass>
        <inertia>
          <ixx>1.0699999999999999e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.096e-06</iyy>
          <iyz>0</iyz>
          <izz>3.8700000000000001e-07</izz>
        </inertia>
      </inertial>
      <collision name='middle2_link_collision_collision'>
        <pose>0.0010300000000000001 -1.7e-05 -0.012930000000000001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.017604000000000002 0.016469000000000001 0.036516</size>
